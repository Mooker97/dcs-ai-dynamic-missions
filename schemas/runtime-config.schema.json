      "properties": {
        "x": {
          "description": "DCS x (north), meters.",
          "title": "X",
          "type": "number"
        },
        "y": {
          "description": "DCS y (east), meters.",
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
