      "title": "Start Time",
      "type": "string"
    },
    "weather_preset": {
      "default": "clear",
      "description": "Weather preset.",
      "enum": [
        "clear",
        "scattered",
        "broken",
        "overcast",
        "rain",
        "storm",
        "dust",
        "fog",
        "night_clear"
      ],
      "title": "Weather Preset",
      "type": "string"
    },
    "mission_type": {
