      "enum": [
        "CAS",
        "SEAD",
        "DEAD",
        "CAP",
        "STRIKE",
        "ESCORT",
        "CSAR",
        "RECON",
        "TRANSPORT",
        "CONVOY_ESCORT"
      ],
      "title": "Mission Type",
      "type": "string"
    },
    "duration_min": {
      "default": 60,
      "description": "Intended mission length.",
      "maximum": 360,
      "minimum": 10,
