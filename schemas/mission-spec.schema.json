          "title": "Role",
          "type": "string"
        },
        "area": {
          "description": "Area id where it is placed.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Area",
          "type": "string"
        },
        "strength": {
          "default": "medium",
