            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
            "type": "string"
          },
          "title": "Route",
          "type": "array"
        },
        "composition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
