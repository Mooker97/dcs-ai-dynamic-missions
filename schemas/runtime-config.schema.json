  "additionalProperties": false,
  "description": "DMS_CONFIG: everything the Lua runtime needs; generated by `dms plan`.",
  "properties": {
    "version": {
      "const": 1,
      "default": 1,
      "description": "Config format version.",
      "title": "Version",
      "type": "integer"
    },
    "seed": {
      "default": 0,
      "description": "Planner seed; Lua mixes it with timer entropy.",
      "title": "Seed",
      "type": "integer"
    },
    "debug": {
      "default": false,
      "description": "Enable DMS debug logging.",
      "title": "Debug",
      "type": "boolean"
    },
    "mission_id": {
      "description": "Mission id, echoed in [DMS.OUTCOME] lines.",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
      "title": "Mission Id",
      "type": "string"
    },
    "budgets": {
      "$ref": "#/$defs/Budgets",
      "description": "Unit/spawn caps."
    },
    "director": {
      "$ref": "#/$defs/Director",
      "description": "Pacing director."
    },
    "templates": {
      "additionalProperties": {
        "$ref": "#/$defs/Template"
      },
      "description": "Template id -> template.",
      "title": "Templates",
      "type": "object"
    },
    "zones": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "circle": "#/$defs/CircleZone",
            "polygon": "#/$defs/PolygonZone"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/CircleZone"
          },
          {
            "$ref": "#/$defs/PolygonZone"
          }
        ]
      },
      "description": "Zone id -> zone.",
      "title": "Zones",
      "type": "object"
    },
    "pools": {
      "additionalProperties": {
        "$ref": "#/$defs/Pool"
      },
      "description": "Pool id -> pool.",
      "title": "Pools",
      "type": "object"
    },
    "encounters": {
      "description": "Encounters.",
      "items": {
        "$ref": "#/$defs/Encounter"
      },
      "title": "Encounters",
      "type": "array"
    },
    "beats": {
      "description": "Compiled beats (beats.yaml).",
      "items": {
        "$ref": "#/$defs/Beat"
      },
      "title": "Beats",
      "type": "array"
    },
    "voice": {
      "additionalProperties": {
        "$ref": "#/$defs/VoiceEntry"
      },
      "description": "Line id -> audio.",
      "title": "Voice",
      "type": "object"
    },
    "intel": {
      "$ref": "#/$defs/Intel",
      "description": "Fog of war / intel."
    },
    "players": {
      "$ref": "#/$defs/Players"
    }
  },
  "required": [
    "mission_id"
  ],
  "title": "RuntimeConfig",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dms.local/schemas/runtime-config.schema.json"
}
