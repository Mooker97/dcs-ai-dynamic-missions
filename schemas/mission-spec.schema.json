  "additionalProperties": false,
  "description": "Declarative mission spec (mission-spec.yaml). Areas by reference, forces by role.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "description": "Schema version; always 1.",
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "description": "Mission id, e.g. 'm01-first-light'.",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "description": "Mission title.",
      "title": "Title",
      "type": "string"
    },
    "campaign": {
      "anyOf": [
        {
          "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Campaign slug, if part of one.",
      "title": "Campaign"
    },
    "content_mode": {
      "default": "fictional",
      "description": "Inherited from the bible.",
      "enum": [
        "historical",
        "adapted",
        "fictional"
      ],
      "title": "Content Mode",
      "type": "string"
    },
    "theater": {
      "description": "DCS map.",
      "enum": [
        "Caucasus",
        "Syria",
        "PersianGulf",
        "Nevada",
        "MarianaIslands",
        "Sinai",
        "Kola",
        "Afghanistan",
        "Normandy",
        "TheChannel",
        "Falklands",
        "GermanyCW"
      ],
      "title": "Theater",
      "type": "string"
    },
    "era": {
      "description": "Year; the planner filters units/weapons by it.",
      "maximum": 2100,
      "minimum": 1900,
      "title": "Era",
      "type": "integer"
    },
    "date": {
      "description": "In-game date, YYYY-MM-DD.",
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "start_time": {
      "default": "06:00",
