{
  "$defs": {
    "Area": {
      "additionalProperties": false,
      "description": "A named area other parts of the spec refer to by id (objectives, threats, routes, pools).",
      "properties": {
        "id": {
          "description": "Area id, e.g. 'ridge_north', 'fob_lion', 'hospital'.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What this place is in the story.",
          "title": "Description"
        },
        "where": {
          "description": "How to locate the area on the map.",
          "discriminator": {
            "mapping": {
              "latlon": "#/$defs/LatLonArea",
              "near_airbase": "#/$defs/NearAirbase",
              "near_named_place": "#/$defs/NearNamedPlace",
              "zone": "#/$defs/PolygonArea"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NearAirbase"
            },
            {
              "$ref": "#/$defs/NearNamedPlace"
            },
            {
              "$ref": "#/$defs/LatLonArea"
            },
            {
              "$ref": "#/$defs/PolygonArea"
            }
          ],
          "title": "Where"
        },
        "terrain": {
          "default": "any",
          "description": "Placement hint the planner uses when choosing spawn points.",
          "enum": [
            "any",
            "road",
            "open",
            "urban",
            "high_ground",
            "water"
          ],
          "title": "Terrain",
          "type": "string"
        }
      },
      "required": [
        "id",
        "where"
      ],
      "title": "Area",
      "type": "object"
    },
    "DirectorIntent": {
      "additionalProperties": false,
      "description": "AI-director pacing intent.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Use the intensity director.",
          "title": "Enabled",
          "type": "boolean"
        },
        "intensity": {
          "default": "moderate",
          "description": "Target peak intensity.",
          "enum": [
            "calm",
            "moderate",
            "intense"
          ],
          "title": "Intensity",
          "type": "string"
        },
        "adaptive": {
          "default": true,
          "description": "Allow hidden difficulty adaptation (clamped to +-1 tier).",
          "title": "Adaptive",
          "type": "boolean"
        }
      },
      "title": "DirectorIntent",
      "type": "object"
    },
    "DynamicIntent": {
      "additionalProperties": false,
      "description": "High-level description of runtime randomness. Python decides the space; Lua picks the instance.",
      "properties": {
        "pools": {
          "description": "Enemy spawn pools.",
          "items": {
            "$ref": "#/$defs/PoolIntent"
          },
          "title": "Pools",
          "type": "array"
        },
        "encounters": {
          "description": "Dynamic encounters.",
          "items": {
            "$ref": "#/$defs/EncounterIntent"
          },
          "title": "Encounters",
          "type": "array"
        },
        "director": {
          "$ref": "#/$defs/DirectorIntent",
          "description": "Pacing intent."
        },
        "fog_of_war": {
          "$ref": "#/$defs/FogOfWarIntent",
          "description": "Fog-of-war intent."
        }
      },
      "title": "DynamicIntent",
      "type": "object"
    },
    "EncounterIntent": {
      "additionalProperties": false,
      "description": "A dynamic event: pop-up SAM, reinforcement waves, hunters, enemy CAP.",
      "properties": {
        "id": {
          "description": "Encounter id, e.g. 'popup_sam', 'qrf'.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "Encounter behaviour.",
          "enum": [
            "ambush_sam",
            "waves",
            "hunt",
            "convoy",
            "cap",
            "pool"
          ],
          "title": "Kind",
          "type": "string"
        },
        "pool": {
          "description": "Pool id it draws from.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Pool",
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/EncounterTriggerIntent",
          "description": "What starts the encounter."
        },
        "chance": {
          "default": 100,
          "description": "Percent chance it happens per play.",
          "maximum": 100,
          "minimum": 0,
          "title": "Chance",
          "type": "integer"
        },
        "telegraph_beat": {
          "anyOf": [
            {
              "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Beat that warns players 30-60 s before (e.g. RWR spike call). Strongly recommended.",
          "title": "Telegraph Beat"
        },
        "waves": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of waves (kind=waves).",
          "title": "Waves"
        },
        "gap_min": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "[min, max] minutes between waves.",
          "title": "Gap Min"
        },
        "hunt": {
          "default": false,
          "description": "Spawned groups actively hunt the players.",
          "title": "Hunt",
          "type": "boolean"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Design intent.",
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "kind",
        "pool",
        "trigger"
      ],
      "title": "EncounterIntent",
      "type": "object"
    },
    "EncounterTriggerIntent": {
      "additionalProperties": false,
      "description": "When an encounter starts.",
      "properties": {
        "type": {
          "description": "proximity: players near an area; beat: a beat fires; director: pacing; time: after N minutes.",
          "enum": [
            "proximity",
            "beat",
            "director",
            "time"
          ],
          "title": "Type",
          "type": "string"
        },
        "area": {
          "anyOf": [
            {
              "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Area id (proximity).",
          "title": "Area"
        },
        "radius_nm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Trigger radius in nm (proximity).",
          "title": "Radius Nm"
        },
        "beat": {
          "anyOf": [
            {
              "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Beat id (beat).",
          "title": "Beat"
        },
        "after_min": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Minutes after start (time).",
          "title": "After Min"
        }
      },
      "required": [
        "type"
      ],
      "title": "EncounterTriggerIntent",
      "type": "object"
    },
    "FogOfWarIntent": {
      "additionalProperties": false,
      "description": "Fog-of-war intent: enemies hidden until detected, then shown as F10 marks.",
      "properties": {
        "enabled": {
          "default": true,
          "description": "Hide enemies and reveal via F10 marks.",
          "title": "Enabled",
          "type": "boolean"
        },
        "reveal_radius_km": {
          "default": 5,
          "description": "Detection reveal radius.",
          "exclusiveMinimum": 0,
          "title": "Reveal Radius Km",
          "type": "number"
        },
        "mark_refresh_sec": {
          "default": 15,
          "description": "How often marks update.",
          "exclusiveMinimum": 0,
          "title": "Mark Refresh Sec",
          "type": "integer"
        }
      },
      "title": "FogOfWarIntent",
      "type": "object"
    },
    "LatLon": {
      "additionalProperties": false,
      "description": "A geographic point in WGS84 decimal degrees.",
      "properties": {
        "lat": {
          "description": "Latitude in decimal degrees (north positive).",
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "description": "Longitude in decimal degrees (east positive).",
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "LatLon",
      "type": "object"
    },
    "LatLonArea": {
      "additionalProperties": false,
      "description": "A circle around an explicit lat/lon. Use when no named place fits.",
      "properties": {
        "kind": {
          "const": "latlon",
          "default": "latlon",
          "description": "Area reference type (discriminator).",
          "title": "Kind",
          "type": "string"
        },
        "lat": {
          "description": "Latitude, decimal degrees.",
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "description": "Longitude, decimal degrees.",
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "radius_nm": {
          "default": 2,
          "description": "Area radius in nautical miles.",
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Radius Nm",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "LatLonArea",
      "type": "object"
    },
    "NearAirbase": {
      "additionalProperties": false,
      "description": "An area around (or offset from) a DCS airbase.",
      "properties": {
        "kind": {
          "const": "near_airbase",
          "default": "near_airbase",
          "description": "Area reference type (discriminator).",
          "title": "Kind",
          "type": "string"
        },
        "airbase": {
          "description": "Airbase name as DCS knows it, e.g. 'Incirlik', 'Hatay', 'Kutaisi'. Use find_airbase.",
          "title": "Airbase",
          "type": "string"
        },
        "radius_nm": {
          "default": 3,
          "description": "Area radius in nautical miles.",
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Radius Nm",
          "type": "number"
        },
        "bearing_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional true bearing to offset the area center.",
          "title": "Bearing Deg"
        },
        "distance_nm": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Offset distance along bearing_deg.",
          "title": "Distance Nm"
        }
      },
      "required": [
        "airbase"
      ],
      "title": "NearAirbase",
      "type": "object"
    },
    "NearNamedPlace": {
      "additionalProperties": false,
      "description": "An area around a town, landmark or map label.",
      "properties": {
        "kind": {
          "const": "near_named_place",
          "default": "near_named_place",
          "description": "Area reference type (discriminator).",
          "title": "Kind",
          "type": "string"
        },
        "place": {
          "description": "Town or landmark name on the DCS map, e.g. 'Idlib', 'Jisr al-Shughur'.",
          "title": "Place",
          "type": "string"
        },
        "radius_nm": {
          "default": 2,
          "description": "Area radius in nautical miles.",
          "exclusiveMinimum": 0,
          "maximum": 200,
          "title": "Radius Nm",
          "type": "number"
        },
        "bearing_deg": {
          "anyOf": [
            {
              "exclusiveMaximum": 360,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional offset bearing.",
          "title": "Bearing Deg"
        },
        "distance_nm": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Offset distance.",
          "title": "Distance Nm"
        }
      },
      "required": [
        "place"
      ],
      "title": "NearNamedPlace",
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "description": "A mission objective, checkable at runtime via flags.",
      "properties": {
        "id": {
          "description": "Objective id, e.g. 'convoy_arrives'.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "description": "Objective type.",
          "enum": [
            "destroy",
            "protect",
            "escort",
            "reach",
            "recon",
            "rescue",
            "survive",
            "land"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "description": "Briefing text for this objective.",
          "title": "Description",
          "type": "string"
        },
        "primary": {
          "default": true,
          "description": "Primary objectives decide success.",
          "title": "Primary",
          "type": "boolean"
        },
        "area": {
          "anyOf": [
            {
              "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Area id where it happens.",
          "title": "Area"
        },
        "target": {
          "anyOf": [
            {
              "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Threat or support id this objective is about.",
          "title": "Target"
        },
        "success_flag": {
          "anyOf": [
            {
              "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Flag a beat sets when the objective succeeds.",
          "title": "Success Flag"
        },
        "failure_flag": {
          "anyOf": [
            {
              "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Flag a beat sets when the objective fails.",
          "title": "Failure Flag"
        }
      },
      "required": [
        "id",
        "kind",
        "description"
      ],
      "title": "Objective",
      "type": "object"
    },
    "PlayerFlight": {
      "additionalProperties": false,
      "description": "A flight of player (client) aircraft.",
      "properties": {
        "callsign": {
          "description": "Flight callsign, e.g. 'Dustoff', 'Gunfighter'.",
          "title": "Callsign",
          "type": "string"
        },
        "aircraft": {
          "description": "DCS aircraft type id, e.g. 'AH-64D_BLK_II', 'F-16C_50', 'UH-60L'. Use list_units.",
          "title": "Aircraft",
          "type": "string"
        },
        "count": {
          "default": 2,
          "description": "Number of client slots in the flight.",
          "maximum": 4,
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "coalition": {
          "default": "blue",
          "description": "Side the players fly for.",
          "enum": [
            "blue",
            "red",
            "neutral"
          ],
          "title": "Coalition",
          "type": "string"
        },
        "country": {
          "default": "USA",
          "description": "DCS country of the aircraft.",
          "title": "Country",
          "type": "string"
        },
        "start_area": {
          "description": "Area id where the flight starts (usually near_airbase/FARP).",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Start Area",
          "type": "string"
        },
        "start_type": {
          "default": "parking_cold",
          "description": "How the flight starts.",
          "enum": [
            "runway",
            "parking_hot",
            "parking_cold",
            "air"
          ],
          "title": "Start Type",
          "type": "string"
        },
        "loadout": {
          "default": "auto",
          "description": "Loadout intent, e.g. 'anti-armor: 8 Hellfire + rockets', or 'auto' for role default.",
          "title": "Loadout",
          "type": "string"
        },
        "frequency_mhz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Flight frequency in MHz; null lets the planner choose.",
          "title": "Frequency Mhz"
        },
        "tasking": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What this flight is told to do.",
          "title": "Tasking"
        }
      },
      "required": [
        "callsign",
        "aircraft",
        "start_area"
      ],
      "title": "PlayerFlight",
      "type": "object"
    },
    "PolygonArea": {
      "additionalProperties": false,
      "description": "A polygon zone given as lat/lon vertices (at least 3), in order.",
      "properties": {
        "kind": {
          "const": "zone",
          "default": "zone",
          "description": "Area reference type (discriminator).",
          "title": "Kind",
          "type": "string"
        },
        "points": {
          "description": "Polygon vertices, clockwise or not.",
          "items": {
            "$ref": "#/$defs/LatLon"
          },
          "minItems": 3,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "title": "PolygonArea",
      "type": "object"
    },
    "PoolIntent": {
      "additionalProperties": false,
      "description": "A weighted set of enemy group types that the runtime draws from.",
      "properties": {
        "id": {
          "description": "Pool id, e.g. 'aaa', 'qrf_btr'.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "roles": {
          "description": "Roles the pool's templates fill.",
          "items": {
            "enum": [
              "sam_short",
              "sam_medium",
              "sam_long",
              "aaa",
              "manpads",
              "armor",
              "ifv",
              "technicals",
              "infantry",
              "artillery",
              "fighters",
              "attack_helicopters",
              "ship",
              "hvt",
              "civilian"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Roles",
          "type": "array"
        },
        "areas": {
          "description": "Area ids where pool members may spawn.",
          "items": {
            "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Areas",
          "type": "array"
        },
        "pick": {
          "default": [
            1,
            3
          ],
          "description": "[min, max] groups drawn each time the pool is used.",
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Pick",
          "type": "array"
        },
        "faction": {
          "anyOf": [
            {
              "description": "Stable identifier. Use lower_snake_case for authored ids (e.g. 'ops_mustang', 'convoy_hit'); letters, digits, '_', '.', '-' only, no spaces.",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bible faction id.",
          "title": "Faction"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Weighting hints, e.g. 'mostly ZU-23, rare SA-8'.",
          "title": "Notes"
        }
      },
      "required": [
        "id",
        "roles",
        "areas"
      ],
      "title": "PoolIntent",
      "type": "object"
    },
    "Support": {
