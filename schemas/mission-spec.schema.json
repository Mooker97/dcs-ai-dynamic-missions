  },
  "required": [
    "id",
    "title",
    "theater",
    "era",
    "date",
    "mission_type",
    "areas",
    "player_flights",
    "objectives"
  ],
  "title": "MissionSpec",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dms.local/schemas/mission-spec.schema.json"
