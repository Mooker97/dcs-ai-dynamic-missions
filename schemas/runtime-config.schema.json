        "type": {
          "description": "DCS unit type id, e.g. 'Osa 9A33 ln'.",
          "title": "Type",
          "type": "string"
        },
        "dx": {
          "default": 0,
          "description": "Offset north (DCS x), meters.",
          "title": "Dx",
          "type": "number"
        },
        "dy": {
          "default": 0,
          "description": "Offset east (DCS y), meters.",
          "title": "Dy",
          "type": "number"
        },
        "heading": {
          "default": 0,
          "description": "Heading in radians.",
          "title": "Heading",
          "type": "number"
        }
      },
      "required": [
        "type"
      ],
      "title": "TemplateUnit",
      "type": "object"
