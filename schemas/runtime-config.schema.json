    "VoiceEntry": {
      "additionalProperties": false,
      "description": "Rendered audio for a voice line id.",
      "properties": {
        "file": {
          "description": "File name inside the .miz (l10n/DEFAULT/).",
          "title": "File",
          "type": "string"
        },
        "text": {
          "description": "Subtitle text.",
          "title": "Text",
          "type": "string"
        },
        "dur_sec": {
          "description": "Duration in seconds.",
          "exclusiveMinimum": 0,
          "title": "Dur Sec",
          "type": "number"
        },
        "speaker": {
          "description": "Character id.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Speaker",
          "type": "string"
        }
      },
      "required": [
        "file",
        "text",
        "dur_sec",
        "speaker"
      ],
      "title": "VoiceEntry",
      "type": "object"
    },
    "XY": {
      "additionalProperties": false,
