          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "role": {
          "description": "Kind of friendly asset.",
          "enum": [
            "convoy",
            "friendly_ground",
            "jtac",
            "awacs",
            "tanker",
            "escort",
            "cap",
            "cas",
            "medevac",
            "farp"
          ],
          "title": "Role",
          "type": "string"
        },
        "callsign": {
          "anyOf": [
            {
              "type": "string"
